# Copy this file to .env in the frontend/ folder and set the backend address.
#
# The backend runs on a separate machine, so this must be that machine's IP —
# not localhost, which would point at whichever device is viewing the page.
# Find it on the backend machine with `ipconfig` (Windows) or `ip addr` (Linux).
#
#   VITE_API_BASE=http://192.168.1.42:8000
#
# No trailing slash. Vite inlines this at BUILD time, so restart `npm run dev`
# (or re-run `npm run build`) after changing it.
VITE_API_BASE=
