# ---------------------------------------------------------------------------
# Single .gitignore for the whole repo (backend + frontend). Previously split
# between root and frontend/ — merged here so there is one place to look.
# ---------------------------------------------------------------------------

# --- Secrets -------------------------------------------------------------
# Never commit these. Real values go in a local .env, which stays untracked;
# .env.example files carry the placeholder names only.
.env
.env.*
!.env.example
*.key
secrets.json

# --- Python --------------------------------------------------------------
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.venv/
venv/

# --- Node / frontend -----------------------------------------------------
node_modules
dist
dist-ssr
*.local

# --- Logs ----------------------------------------------------------------
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Editors / OS --------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
