# Copy this file to .env in the same directory and fill in the real value.
# .env is gitignored — never commit the actual key.
#
# OPTIONAL. Live weather already works without it: the API falls back to
# Open-Meteo, which needs no key. Set this only if you want OpenWeather's
# measured station data in preference to Open-Meteo's forecast grid.
#
# Free key from https://openweathermap.org/api (sign up, "API keys" tab).
# A new key can take ~10 minutes to activate.
OPENWEATHER_API_KEY=
