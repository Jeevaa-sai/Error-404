# Copy this file to .env in the same directory and fill in the real value.
# .env is gitignored — never commit the actual key.
#
# Required for live weather. Without it the API falls back to estimated wind
# derived from the coordinates and reports confidence "fallback", and the
# "use live wind" button returns 503.
#
# Free key from https://openweathermap.org/api (sign up, "API keys" tab).
# A new key can take ~10 minutes to activate.
OPENWEATHER_API_KEY=
